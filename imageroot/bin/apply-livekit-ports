#
# Give LiveKit its loopback ports, then open or close its media ports in the firewall.
#
# A new instance gets 7 TCP ports from the image labels. An instance updated
# from an older release still has 5: the core stores the new demand on update
# but allocates nothing, so the 2 missing ports are allocated here, once, and
# kept in the module environment.
#

import os
import sys

import agent

# Fixed, so the router forward survives a restore, a clone or a move to another node
MEDIA_PORTS = ["7881/tcp", "7882/udp"]
TURN_PORT = "3478/udp"

# agent.set_env() does not update os.environ: read the file back
env = agent.read_envfile(os.path.join(os.environ["AGENT_STATE_DIR"], "environment"))
config = agent.read_envfile("config.env") if os.path.exists("config.env") else {}

tcp_ports = [p for p in env.get("TCP_PORTS", "").split(",") if p]
if len(tcp_ports) >= 7:
    http_port, jwt_port = tcp_ports[5], tcp_ports[6]
elif env.get("LIVEKIT_TCP_PORTS"):
    livekit_tcp = env["LIVEKIT_TCP_PORTS"].split(",")
    http_port, jwt_port = livekit_tcp[0], livekit_tcp[-1]
else:
    start, end = agent.allocate_ports(2, "tcp", keep_existing=True)
    # Stored before anything else can fail: a second allocation would exceed the demand
    agent.set_env("LIVEKIT_TCP_PORTS", f"{start},{end}")
    http_port, jwt_port = str(start), str(end)
    print(f"allocated TCP ports {start}-{end} for LiveKit", file=sys.stderr)

agent.set_env("LIVEKIT_HTTP_PORT", http_port)
agent.set_env("LK_JWT_PORT", jwt_port)

module_id = os.environ["MODULE_ID"]
if config.get("LIVEKIT_ENABLED") == "1":
    ports = list(MEDIA_PORTS)
    if config.get("LIVEKIT_TURN_ENABLED") == "1":
        ports.append(TURN_PORT)
    agent.assert_exp(agent.add_public_service(module_id, ports, replace_ports=True))
    print(f"public ports: {' '.join(ports)}", file=sys.stderr)
else:
    agent.remove_public_service(module_id)
