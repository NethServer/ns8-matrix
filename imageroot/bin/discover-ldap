#
# Find settings for LDAP service
#

import ipaddress
import os
import socket
import agent
from agent.ldapproxy import Ldapproxy


def is_node_loopback(host):
    # Resolved on the node, so a name mapped to 127.x in /etc/hosts counts too
    try:
        return any(ipaddress.ip_address(a[4][0]).is_loopback for a in socket.getaddrinfo(host, None))
    except (OSError, ValueError):
        return False

if os.path.exists("config.env"):
    config = agent.read_envfile("config.env")
else:
    config = {}

udomname = config.get('LDAP_DOMAIN','')

try:
    odom = Ldapproxy().get_domain(udomname)
    'host' in odom # Throw exception if odom is None
except:
    # During restore the domain could be unavailable. Use a fallback
    # configuration, pointing to nowhere, just to set the variables.
    # Once the domain becomes available, the event will fix them.
    odom = {
        'host': '127.0.0.1',
        'port': 20000,
        'schema': 'rfc2307',
        'location': 'internal',
        'base_dn': 'dc=synapse,dc=invalid',
        'bind_dn': 'cn=example,dc=synapse,dc=invalid',
        'bind_password': 'invalid',
    }

# Synapse runs in a pod: the node loopback is the pod gateway, see matrix.service
if is_node_loopback(odom['host']):
    odom['host'] = '10.0.2.2'

tmpfile = "ldap.env." + str(os.getpid())

if odom['schema'] == "rfc2307":
    with open(tmpfile, "w") as denv:
        print('LDAP_PORT=' + str(odom['port']), file=denv)
        print('LDAP_BIND_DN=' + odom['bind_dn'], file=denv)
        print('LDAP_HOST=' + odom['host'], file=denv)
        print('LDAP_BIND_PASSWORD=' + odom['bind_password'], file=denv)
        print('LDAP_SCHEMA=' + odom['schema'], file=denv)
        print('LDAP_BASE_DN=ou=people,' + odom['base_dn'], file=denv)
        print('LDAP_USERNAME=uid', file=denv)
        print('LDAP_EMAIL_ATTR=mail', file=denv)
        print('LDAP_NAME_ATTR=displayName', file=denv)
elif odom['schema'] == "ad":
    with open(tmpfile, "w") as denv:
        print('LDAP_PORT=' + str(odom['port']), file=denv)
        print('LDAP_BIND_DN=' + odom['bind_dn'], file=denv)
        print('LDAP_HOST=' + odom['host'], file=denv)
        print('LDAP_BIND_PASSWORD=' + odom['bind_password'], file=denv)
        print('LDAP_SCHEMA=' + odom['schema'], file=denv)
        print('LDAP_BASE_DN=cn=Users,' + odom['base_dn'], file=denv)
        print('LDAP_USERNAME=sAMAccountName', file=denv)
        print('LDAP_EMAIL_ATTR=mail', file=denv)
        print('LDAP_NAME_ATTR=displayName', file=denv)

os.replace(tmpfile, "ldap.env")
