import os
import json
import re
import secrets
import string
import agent

# Environment variables substituted into synapse-homeserver.yaml as string
# scalars. Their values are user supplied (SMTP host and sender, LDAP bind DN
# and password) and may contain characters that are reserved in YAML when
# they appear at the start of a value ('@', '*', '&', '!', '%', quotes ...) or
# special sequences (':', '#', '\'). They must therefore be emitted as
# properly quoted and escaped YAML strings. Keys NOT listed here (ports,
# booleans) are substituted verbatim so they keep their native YAML type.
# The SMTP username and password are quoted in synapse_derived_vars instead,
# because they become null without a username: do not add them here.
SYNAPSE_QUOTED_KEYS = (
    "SYNAPSE_SMTP_HOST",
    "SYNAPSE_SMTP_FROM",
    "LDAP_BIND_DN",
    "LDAP_BIND_PASSWORD",
)

def split_list(value):
    """Turn a comma separated config.env value into a list, dropping blanks"""
    return [item.strip() for item in value.split(',') if item.strip()]

def days_or_null(value):
    """Synapse expects a duration like "30d", or null to keep media forever"""
    days = int(value or 0)
    return json.dumps(f'{days}d') if days > 0 else 'null'

def synapse_derived_vars(env_vars):
    """Compute the values that the templates cannot express with a plain substitution"""
    federation = env_vars.get('FEDERATION', '0') == '1'
    livekit = env_vars.get('LIVEKIT_ENABLED', '0') == '1'
    whitelist = split_list(env_vars.get('FEDERATION_WHITELIST', ''))
    # null allows every server, an empty list also blocks the requests we send out
    if not federation:
        federation_whitelist = '[]'
    elif whitelist:
        federation_whitelist = json.dumps(whitelist)
    else:
        federation_whitelist = 'null'
    turn_uris = split_list(env_vars.get('TURN_URIS', ''))
    turn_secret = env_vars.get('TURN_SHARED_SECRET', '')
    # Synapse requires SMTP authentication as soon as smtp_user is set, even to ""
    smtp_user = env_vars.get('SYNAPSE_SMTP_USERNAME', '')
    smtp_pass = env_vars.get('SYNAPSE_SMTP_PASSWORD', '')
    log_level = env_vars.get('LOG_LEVEL', 'INFO')
    if log_level not in ('INFO', 'WARNING', 'DEBUG'):
        log_level = 'INFO'
    return {
        # lk-jwt-service checks who a caller is through the OpenID userinfo endpoint,
        # which lives under /_matrix/federation even when federation is off
        'SYNAPSE_LISTENER_RESOURCES': 'client, federation' if federation else ('client, openid' if livekit else 'client'),
        # lk-jwt-service finds that endpoint through the server well-known, else it tries port 8448
        'SYNAPSE_SERVE_SERVER_WELLKNOWN': 'true' if federation or livekit else 'false',
        'SYNAPSE_FEDERATION_WHITELIST': federation_whitelist,
        'ELEMENT_DEFAULT_FEDERATE': 'true' if federation else 'false',
        'SYNAPSE_SMTP_USER_VALUE': json.dumps(smtp_user, ensure_ascii=False) if smtp_user else 'null',
        'SYNAPSE_SMTP_PASS_VALUE': json.dumps(smtp_pass, ensure_ascii=False) if smtp_user else 'null',
        'SYNAPSE_TURN_URIS': json.dumps(turn_uris),
        'SYNAPSE_TURN_SHARED_SECRET': json.dumps(turn_secret) if turn_uris and turn_secret else 'null',
        'SYNAPSE_MAX_UPLOAD_SIZE': str(int(env_vars.get('MAX_UPLOAD_SIZE_MB') or 50)) + 'M',
        'SYNAPSE_LOCAL_MEDIA_LIFETIME': days_or_null(env_vars.get('LOCAL_MEDIA_LIFETIME_DAYS')),
        'SYNAPSE_REMOTE_MEDIA_LIFETIME': days_or_null(env_vars.get('REMOTE_MEDIA_LIFETIME_DAYS')),
        'SYNAPSE_LOG_LEVEL': log_level,
        'SYNAPSE_SEARCH_ALL_USERS': 'true' if env_vars.get('SEARCH_ALL_USERS', '0') == '1' else 'false',
        # DEBUG on the SQL logger prints access tokens, never go below INFO there
        'SYNAPSE_SQL_LOG_LEVEL': 'WARNING' if log_level == 'WARNING' else 'INFO',
    }

def write_private(path, content):
    """Write an owner-only file atomically: synapse, livekit and lk-jwt run this script at the same time."""
    tmp = path + '.tmp' + str(os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(content)
    os.replace(tmp, path)


def generate_secret(length=32):
    """Generate a random secret string"""
    alphabet = string.ascii_letters + string.digits
    return ''.join(secrets.choice(alphabet) for _ in range(length))

def substitute_env_vars(content, env_vars, quoted_keys=()):
    """Replace ${VAR} patterns with environment variable values.

    Values whose key is listed in quoted_keys are rendered as a double quoted,
    fully escaped string scalar via json.dumps(). A JSON string literal is also
    a valid YAML double quoted scalar, so this protects the generated document
    from values containing YAML reserved characters. All other values are
    substituted verbatim, preserving numeric and boolean YAML types.
    """
    # One pass, so a value holding "${...}" is never expanded again
    def replace(match):
        key = match.group(1)
        if key not in env_vars:
            return match.group(0)
        if key in quoted_keys:
            return json.dumps(str(env_vars[key]), ensure_ascii=False)
        return str(env_vars[key])
    return re.sub(r'\$\{(\w+)\}', replace, content)

# Read environment variables from config
env_vars = agent.read_envfile("config.env")

# Read LDAP environment if available
ldap_env = agent.read_envfile("ldap.env")
env_vars.update(ldap_env)

# Generate postgres secrets if they don't exist
secrets_file = 'database.env'
if not os.path.exists(secrets_file):
    secrets_env = {
        "POSTGRES_PASSWORD": generate_secret()
    }
    agent.write_envfile(secrets_file, secrets_env)

# Read postgres environment if available
database_env = agent.read_envfile("database.env")
env_vars.update(database_env)

# Generate secrets if they don't exist
secrets_file = 'matrix-secrets.env'
if not os.path.exists(secrets_file):
    secrets_env = {
        "REGISTRATION_SECRET": generate_secret(),
        "MACAROON_SECRET": generate_secret(),
        "FORM_SECRET": generate_secret(),
        "SYNAPSE_SECRET": generate_secret(),
        "M2A_AS_TOKEN": generate_secret(64),
        "M2A_HS_TOKEN": generate_secret(64)
    }
    secrets_env["MATRIX_AS_TOKEN"] = secrets_env['M2A_AS_TOKEN']
    agent.write_envfile(secrets_file, secrets_env)

# Read generated secrets
secrets_env = agent.read_envfile(secrets_file)
env_vars.update(secrets_env)

# Read smarthost settings if available
smarthost_env = agent.read_envfile("smarthost.env")
env_vars.update(smarthost_env)

# The TURN secret lives in its own file, so it never appears in config.env or config.json
turn_env = agent.read_envfile("turn.env") if os.path.exists("turn.env") else {}
env_vars.update(turn_env)

env_vars.update(synapse_derived_vars(env_vars))

# Create configuration directories
os.makedirs('synapse-config', exist_ok=True)
os.makedirs('element-config', exist_ok=True)
os.makedirs('cinny-config', exist_ok=True)

# Template directory
template_dir = '../templates'

# Process Synapse configuration
with open(f'{template_dir}/synapse-homeserver.yaml', 'r') as f:
    synapse_config = substitute_env_vars(f.read(), env_vars, SYNAPSE_QUOTED_KEYS)
 
with open('synapse-config/homeserver.yaml', 'w') as f:
    f.write(synapse_config)

    # If NETHVOICE_AUTH_URL is set, append the appservice lines to the generated homeserver.yaml
    if env_vars.get('NETHVOICE_AUTH_URL'):
        f.write('\napp_service_config_files:\n   - /data/config/matrix2acrobits.yaml\n')

    if env_vars.get('LIVEKIT_ENABLED') == '1':
        with open(f'{template_dir}/synapse-livekit.yaml', 'r') as lf:
            f.write(substitute_env_vars(lf.read(), env_vars))

# Expand matrix2acrobits.yaml into the synapse config directory
with open(f'{template_dir}/matrix2acrobits.yaml', 'r') as f:
    matrix_a2a = substitute_env_vars(f.read(), env_vars)

with open('synapse-config/matrix2acrobits.yaml', 'w') as f:
    f.write(matrix_a2a)

# Render log config
with open(f'{template_dir}/synapse-log.config', 'r') as f:
    log_config = substitute_env_vars(f.read(), env_vars)

with open('synapse-config/log.config', 'w') as f:
    f.write(log_config)

# Process Element configuration
with open(f'{template_dir}/element-config.json', 'r') as f:
    element_config = substitute_env_vars(f.read(), env_vars)

# With LiveKit every call goes through Element Call, so Element Web and Element X can call each other
if env_vars.get('LIVEKIT_ENABLED') == '1':
    element_json = json.loads(element_config)
    element_json['element_call'] = {'use_exclusively': True}
    element_config = json.dumps(element_json, indent=4)

with open('element-config/config.json', 'w') as f:
    f.write(element_config)

# LiveKit and lk-jwt-service hold the API secret: owner only
livekit_env = agent.read_envfile("livekit.env") if os.path.exists("livekit.env") else {}
if env_vars.get('LIVEKIT_ENABLED') == '1' and livekit_env:
    livekit_vars = dict(env_vars)
    livekit_vars.update(livekit_env)
    livekit_vars.update({
        'LIVEKIT_HTTP_PORT': os.environ['LIVEKIT_HTTP_PORT'],
        'LIVEKIT_RTC_TCP_PORT': os.environ['LIVEKIT_RTC_TCP_PORT'],
        'LIVEKIT_RTC_UDP_PORT': os.environ['LIVEKIT_RTC_UDP_PORT'],
        'LK_JWT_PORT': os.environ['LK_JWT_PORT'],
        'LIVEKIT_NODE_IP': env_vars.get('LIVEKIT_PUBLIC_ADDRESS') or os.environ.get('DETECTED_PUBLIC_IP', ''),
        'LIVEKIT_TURN_ENABLED_BOOL': 'true' if env_vars.get('LIVEKIT_TURN_ENABLED') == '1' else 'false',
        'LIVEKIT_LOG_LEVEL': {'DEBUG': 'debug', 'WARNING': 'warn'}.get(env_vars.get('LOG_LEVEL'), 'info'),
    })
    os.makedirs('livekit-config', exist_ok=True)
    with open(f'{template_dir}/livekit.yaml', 'r') as f:
        livekit_config = substitute_env_vars(f.read(), livekit_vars)
    write_private('livekit-config/livekit.yaml', livekit_config)

    write_private('lk-jwt.env', ''.join([
        f"LIVEKIT_URL=wss://{env_vars['SYNAPSE_DOMAIN_NAME']}/livekit/sfu\n",
        f"LIVEKIT_KEY={livekit_env['LIVEKIT_KEY']}\n",
        f"LIVEKIT_SECRET={livekit_env['LIVEKIT_SECRET']}\n",
        # Only local users may create a call room, remote ones can only join
        f"LIVEKIT_FULL_ACCESS_HOMESERVERS={env_vars['SYNAPSE_DOMAIN_NAME']}\n",
        # Published traffic reaches the pod address, not its loopback
        f"LIVEKIT_JWT_BIND=0.0.0.0:{os.environ['LK_JWT_PORT']}\n",
    ]))

# Process Cinny configuration
with open(f'{template_dir}/cinny-config.json', 'r') as f:
    cinny_config = substitute_env_vars(f.read(), env_vars)

with open('cinny-config/config.json', 'w') as f:
    f.write(cinny_config)
