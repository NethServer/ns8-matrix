exec 1>&2

# The unit file is gone, so the enable link dangles: test it with -L, not -e
[[ -L ../systemd/user/default.target.wants/matrix.service ]] || exit 0

systemctl --user stop matrix.service 2>/dev/null || :
# extract-image removes the unit file, but not its enable link
rm -f ../systemd/user/default.target.wants/matrix.service
systemctl --user daemon-reload
systemctl --user reset-failed matrix.service 2>/dev/null || :
