#
# Older releases used the Matrix host as user domain. Store it as such, so the
# user IDs stay the same and the Matrix host can change from now on.
#

import json
import os

import agent

if not os.path.exists("config.env"):
    exit(0)

env_vars = agent.read_envfile("config.env")
if env_vars.get("MATRIX_SERVER_NAME"):
    exit(0)

env_vars["MATRIX_SERVER_NAME"] = env_vars["SYNAPSE_DOMAIN_NAME"]
agent.write_envfile("config.env", env_vars)

if os.path.exists("config.json"):
    with open("config.json") as cf:
        config = json.load(cf)
    config["matrix_server_name"] = env_vars["MATRIX_SERVER_NAME"]
    with open("config.json", "w") as cf:
        json.dump(config, cf)
