exec 1>&2

# Ensure config.env exists and get the env variables
touch config.env
source config.env

# Restarting the pod stops every container, then starts PostgreSQL and Synapse again
systemctl --user restart matrix.service

# Start element web client when enabled
if [[ -n ${ELEMENT_DOMAIN_NAME} ]]; then
  systemctl --user start element-web.service
fi

# Start cinny client when enabled
if [[ -n ${CINNY_DOMAIN_NAME} ]]; then
  systemctl --user start cinny.service
fi

# Start Matrix2acrobits service when enabled
if [[ -n ${NETHVOICE_AUTH_URL} ]]; then
  systemctl --user start matrix2acrobits.service
fi
