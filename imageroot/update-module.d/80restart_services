set -e
exec 1>&2

# Do not start a module that is not configured or was stopped on purpose
systemctl --user is-enabled -q synapse.service || exit 0

# Ensure config.env exists and get the env variables
touch config.env
source config.env

# Recreate the pod with the new unit, the running containers restart with it
systemctl --user restart matrix.service
systemctl --user start postgresql.service synapse.service

# Start element web client when enabled
if [[ -n ${ELEMENT_DOMAIN_NAME} ]]; then
  systemctl --user start element-web.service
fi

# Start cinny client when enabled
if [[ -n ${CINNY_DOMAIN_NAME} ]]; then
  systemctl --user start cinny.service
fi

# Start Matrix2acrobits service when enabled
if [[ -n ${NETHVOICE_AUTH_URL} ]]; then
  systemctl --user start matrix2acrobits.service
fi

if [[ ${LIVEKIT_ENABLED} == 1 ]]; then
  # LiveKit is outside the pod: restart it for its new image
  systemctl --user start lk-jwt.service
  systemctl --user restart livekit.service
fi
