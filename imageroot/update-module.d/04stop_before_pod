exec 1>&2

# Once the pod runs there is nothing to do
podman pod exists matrix && exit 0

# The old containers hold the ports the pod publishes. The old oneshot matrix.service also
# still counts as active, so a later start would not create the pod.
systemctl --user stop element-web.service cinny.service matrix2acrobits.service synapse.service postgresql.service
systemctl --user stop matrix.service
systemctl --user enable matrix.service
