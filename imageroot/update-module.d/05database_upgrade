set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

# A data directory created by an older major version keeps PG_VERSION at the
# volume root. PostgreSQL 18 stores it under 18/docker/ instead.
# Read it from the host side: mounting the volume with :Z in a helper
# container relabels it and locks out a running PostgreSQL.
volume_path=$(podman volume inspect postgres-data --format '{{.Mountpoint}}' 2>/dev/null || true)
data_version=""
if [[ -n "${volume_path}" ]]; then
    data_version=$(podman unshare cat "${volume_path}/PG_VERSION" 2>/dev/null || true)
fi

if [[ -z "${data_version}" ]]; then
    echo "PostgreSQL data is already in the current layout, skipping the upgrade"
    exit 0
fi

echo "Upgrading PostgreSQL data from version ${data_version}"
db_clients=()
for unit in synapse.service matrix2acrobits.service; do
    if systemctl --user is-active -q "${unit}"; then
        db_clients+=("${unit}")
    fi
done
systemctl --user stop synapse.service matrix2acrobits.service postgresql.service

# The new image cannot read the old data. Dump it with a temporary container
# of the old major version, so the upgrade also works when the service is down.
old_image="docker.io/postgres:${data_version}-alpine"
podman run --detach --rm --network=none \
    --volume=postgres-data:/var/lib/postgresql/data:Z \
    --replace --name=postgresql-upgrade \
    "${old_image}"
trap 'podman stop --ignore postgresql-upgrade >/dev/null' EXIT

for _ in $(seq 1 60); do
    if podman exec postgresql-upgrade pg_isready -U postgres -q; then
        break
    fi
    sleep 2
done
echo "Dumping all PostgreSQL databases"
podman exec postgresql-upgrade pg_dumpall -U postgres > postgresql.pg_dump
podman stop postgresql-upgrade
trap - EXIT

podman volume rm postgres-data

# Restore the dump into a new volume; the dump file is removed only on success
../actions/restore-module/40restore_database

systemctl --user start postgresql.service "${db_clients[@]}"
podman image rm --ignore "${old_image}"
echo "PostgreSQL data upgraded"
