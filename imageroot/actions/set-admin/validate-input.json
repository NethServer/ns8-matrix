{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "set-admin input",
    "$id": "http://schema.nethserver.org/matrix/set-admin-input.json",
    "description": "Grant or revoke the Synapse server administrator flag of a user",
    "examples": [
        {
            "user": "alice",
            "admin": true
        }
    ],
    "type": "object",
    "required": [
        "user",
        "admin"
    ],
    "properties": {
        "user": {
            "type": "string",
            "description": "User name, without the leading @ and the server name",
            "pattern": "^[a-z0-9._=/+-]+$"
        },
        "admin": {
            "type": "boolean"
        }
    }
}
