{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "configure-module input",
    "$id": "http://schema.nethserver.org/matrix/configure-module-input.json",
    "description": "Configure Matrix chat service",
    "examples": [
        {
            "synapse_domain_name": "matrix.example.com",
            "element_domain_name": "chat.example.com",
            "cinny_domain_name": "cinny.example.com",
            "lets_encrypt": true,
            "ldap_domain": "users.example.com",
            "mail_from": "noreply@example.com",
            "nethvoice_auth_url": "https://voice.nethserver.org/freepbx/rest/testextauth",
            "federation": true,
            "federation_whitelist": [
                "example.org"
            ],
            "turn_uris": [
                "turn:turn.example.com:3478?transport=udp"
            ],
            "turn_shared_secret": "",
            "max_upload_size_mb": 50,
            "local_media_lifetime_days": 0,
            "remote_media_lifetime_days": 0,
            "log_level": "INFO",
            "search_all_users": true,
            "livekit_enabled": true,
            "livekit_turn_enabled": false,
            "livekit_public_address": ""
        }
    ],
    "type": "object",
    "required": [
        "synapse_domain_name",
        "lets_encrypt",
        "ldap_domain"
    ],
    "properties": {
        "synapse_domain_name": {
            "type": "string",
            "description": "Fully qualified domain name for the Matrix homeserver",
            "format": "hostname",
            "minLength": 1
        },
        "matrix_server_name": {
            "type": "string",
            "description": "User domain, the Synapse server_name in @user:domain. Locked once a user exists. Omitted, the stored value is kept, else synapse_domain_name",
            "format": "hostname"
        },
        "element_domain_name": {
            "oneOf": [
                {
                    "type": "string",
                    "format": "hostname"
                },
                {
                    "type": "string",
                    "maxLength": 0
                }
            ]
        },
        "cinny_domain_name": {
            "oneOf": [
                {
                    "type": "string",
                    "format": "hostname"
                },
                {
                    "type": "string",
                    "maxLength": 0
                }
            ]
        },
        "lets_encrypt": {
            "type": "boolean",
            "description": "Enable Let's Encrypt certificate management"
        },
        "ldap_domain": {
            "type": "string",
            "description": "LDAP domain name",
            "format": "domain-name"
        },
        "mail_from": {
            "title": "Email from address",
            "type": "string",
            "oneOf": [
                {
                    "type": "string",
                    "format": "email"
                },
                {
                    "type": "string",
                    "maxLength": 0
                }
            ]
        },
        "nethvoice_auth_url": {
            "description": "NethVoice Authentication URL",
            "oneOf": [
                {
                    "type": "string",
                    "format": "uri"
                },
                {
                    "type": "string",
                    "maxLength": 0
                }
            ]
        },
        "federation": {
            "type": "boolean",
            "description": "Allow other Matrix servers to talk with this one"
        },
        "federation_whitelist": {
            "type": "array",
            "description": "If not empty, federate only with these server names",
            "items": {
                "type": "string",
                "description": "Matrix server name: host name or IP address, optionally followed by :port",
                "pattern": "^(\\[[0-9a-fA-F:.]+\\]|[A-Za-z0-9.-]+)(:[0-9]{1,5})?$",
                "maxLength": 255
            }
        },
        "turn_uris": {
            "type": "array",
            "description": "External TURN server URIs, used for voice and video calls behind NAT",
            "items": {
                "type": "string",
                "pattern": "^turns?:[^,\\s]+$"
            }
        },
        "turn_shared_secret": {
            "type": "string",
            "description": "TURN shared secret (coturn use-auth-secret). An empty value keeps the current secret",
            "pattern": "^[^\\n\\r]*$"
        },
        "max_upload_size_mb": {
            "type": "integer",
            "description": "Largest file a user can upload, in megabytes",
            "minimum": 1,
            "maximum": 2048
        },
        "local_media_lifetime_days": {
            "type": "integer",
            "description": "Delete local media not accessed for this many days, 0 keeps it forever",
            "minimum": 0
        },
        "remote_media_lifetime_days": {
            "type": "integer",
            "description": "Delete cached media from other servers not accessed for this many days, 0 keeps it forever",
            "minimum": 0
        },
        "log_level": {
            "type": "string",
            "enum": [
                "INFO",
                "WARNING",
                "DEBUG"
            ]
        },
        "search_all_users": {
            "type": "boolean",
            "description": "Let users find every user who logged in at least once, not only people they share a room with"
        },
        "turn_clear_secret": {
            "type": "boolean",
            "description": "Remove the stored TURN shared secret. Ignored when a new turn_shared_secret is sent"
        },
        "livekit_enabled": {
            "type": "boolean",
            "description": "Run LiveKit for Element Call voice and video calls"
        },
        "livekit_turn_enabled": {
            "type": "boolean",
            "description": "Enable the LiveKit TURN relay on port 3478/udp. Requires livekit_enabled"
        },
        "livekit_public_address": {
            "description": "Address announced to call clients. Empty uses the detected public address",
            "oneOf": [
                {
                    "type": "string",
                    "format": "ipv4"
                },
                {
                    "type": "string",
                    "format": "ipv6"
                },
                {
                    "type": "string",
                    "maxLength": 0
                }
            ]
        },
        "livekit_tls_skip_verify": {
            "type": "boolean",
            "description": "Test labs only: let lk-jwt-service accept a self signed Synapse certificate"
        }
    }
}
