# If the control reaches this step, the service can be enabled and started

# Ensure all environment files exist
touch ldap.env
touch smarthost.env
touch config.env

source config.env

# Enable Matrix services
systemctl --user enable matrix.service
systemctl --user enable postgresql.service
systemctl --user enable synapse.service

# Enable the optional services set in the UI. Stop the others before the pod restarts:
# the restart would start them again, and a stop during that start fails the unit.
optional=()
[[ -n ${ELEMENT_DOMAIN_NAME} ]] && optional+=(element-web.service) || systemctl --user disable --now element-web.service
[[ -n ${CINNY_DOMAIN_NAME} ]] && optional+=(cinny.service) || systemctl --user disable --now cinny.service
[[ -n ${NETHVOICE_AUTH_URL} ]] && optional+=(matrix2acrobits.service) || systemctl --user disable --now matrix2acrobits.service
if [[ ${#optional[@]} -gt 0 ]]; then
  systemctl --user enable "${optional[@]}"
fi

# Recreate the pod, the running containers restart with it
systemctl --user restart matrix.service
systemctl --user start postgresql.service synapse.service "${optional[@]}"
