# Before any change, so a refusal leaves the module untouched.
#

import json
import os
import subprocess
import sys

import agent

data = json.load(sys.stdin)
config = agent.read_envfile("config.env") if os.path.exists("config.env") else {}

# Omitted keeps the current state, like search_all_users
livekit = data.get("livekit_enabled", config.get("LIVEKIT_ENABLED") == "1")
turn = data.get("livekit_turn_enabled", config.get("LIVEKIT_TURN_ENABLED") == "1")
livekit_was_on = config.get("LIVEKIT_ENABLED") == "1"
turn_was_on = livekit_was_on and config.get("LIVEKIT_TURN_ENABLED") == "1"


def refuse(field, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": data.get(field),
                "error": error}], fp=sys.stdout)
    sys.exit(2)


# Only an explicit request: turning LiveKit off also turns its TURN off
if data.get("livekit_turn_enabled") and not livekit:
    refuse("livekit_turn_enabled", "turn_needs_livekit")


def in_use(*ports):
    owner = subprocess.run(["port-owner", *ports], capture_output=True, text=True)
    if owner.returncode != 0:
        print(agent.SD_ERR + " ".join(ports) + " already in use on this node:\n" + owner.stdout,
              file=sys.stderr)
    return owner.returncode != 0


# Only when switching on: a conflict found later must not block unrelated settings
if livekit and not livekit_was_on and in_use("7881/tcp", "7882/udp"):
    refuse("livekit_enabled", "livekit_port_in_use")

if livekit and turn and not turn_was_on and in_use("3478/udp"):
    refuse("livekit_turn_enabled", "turn_port_in_use")

# Set by add-module, or by apply-livekit-ports on update. Retried here, since a refusal
# would stop the action before 30livekit runs the helper again.
if livekit and turn and not turn_was_on and not os.environ.get("UDP_PORTS_RANGE"):
    agent.run_helper("apply-livekit-ports")
    env = agent.read_envfile(os.path.join(os.environ["AGENT_STATE_DIR"], "environment"))
    if not env.get("UDP_PORTS_RANGE"):
        refuse("livekit_turn_enabled", "turn_no_relay_ports")
