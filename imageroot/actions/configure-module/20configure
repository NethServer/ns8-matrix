import json
import sys
import agent
import agent.tasks
import os

request = json.load(sys.stdin)

# Get configuration parameters
synapse_domain_name = request.get('synapse_domain_name', '')
element_domain_name = request.get('element_domain_name', '')
cinny_domain_name = request.get('cinny_domain_name', '')
lets_encrypt = request.get('lets_encrypt', False)
ldap_domain = request.get('ldap_domain', '')
mail_from = request.get('mail_from', '')
nethvoice_auth_url = request.get('nethvoice_auth_url', '')
federation = request.get('federation', False)
federation_whitelist = request.get('federation_whitelist', [])
turn_uris = request.get('turn_uris', [])
turn_shared_secret = request.pop('turn_shared_secret', '')
turn_clear_secret = request.pop('turn_clear_secret', False)
max_upload_size_mb = request.get('max_upload_size_mb', 50)
local_media_lifetime_days = request.get('local_media_lifetime_days', 0)
remote_media_lifetime_days = request.get('remote_media_lifetime_days', 0)
log_level = request.get('log_level', 'INFO')

if not synapse_domain_name:
    print("ERROR: Synapse_domain_name is required", file=sys.stderr)
    sys.exit(1)

# Check it before writing anything, so a rejected request leaves the module untouched
if turn_uris and not turn_shared_secret and (turn_clear_secret or not os.path.exists('turn.env')):
    agent.set_status('validation-failed')
    json.dump([{'field': 'turn_shared_secret', 'parameter': 'turn_shared_secret', 'value': '', 'error': 'turn_shared_secret_required'}], fp=sys.stdout)
    sys.exit(2)

# Read current configuration
if os.path.exists("config.env"):
    env_vars = agent.read_envfile("config.env")
else:
    env_vars = {}

# Update environment with new configuration
env_vars['SYNAPSE_DOMAIN_NAME'] = synapse_domain_name
env_vars['ELEMENT_DOMAIN_NAME'] = element_domain_name
env_vars['CINNY_DOMAIN_NAME'] = cinny_domain_name
env_vars['LDAP_DOMAIN'] = ldap_domain
env_vars['MAIL_FROM'] = mail_from
env_vars['LETS_ENCRYPT'] = '1' if lets_encrypt else '0'
env_vars['NETHVOICE_AUTH_URL'] = nethvoice_auth_url
env_vars['FEDERATION'] = '1' if federation else '0'
env_vars['FEDERATION_WHITELIST'] = ','.join(federation_whitelist)
env_vars['TURN_URIS'] = ','.join(turn_uris)
env_vars['MAX_UPLOAD_SIZE_MB'] = str(max_upload_size_mb)
env_vars['LOCAL_MEDIA_LIFETIME_DAYS'] = str(local_media_lifetime_days)
env_vars['REMOTE_MEDIA_LIFETIME_DAYS'] = str(remote_media_lifetime_days)
env_vars['LOG_LEVEL'] = log_level
# A request without the key keeps the stored value, or the behavior before this setting existed.
# The UI proposes true for new instances through get-configuration.
if 'search_all_users' in request:
    env_vars['SEARCH_ALL_USERS'] = '1' if request['search_all_users'] else '0'
else:
    env_vars['SEARCH_ALL_USERS'] = env_vars.get('SEARCH_ALL_USERS', '0')
# Saved in config.json, so a restore replays the same value
request['search_all_users'] = env_vars['SEARCH_ALL_USERS'] == '1'

# Omitted keys keep the stored value. Saved in config.json, so a restore replays them.
for key, var in (('livekit_enabled', 'LIVEKIT_ENABLED'), ('livekit_turn_enabled', 'LIVEKIT_TURN_ENABLED'),
                 ('livekit_tls_skip_verify', 'LIVEKIT_TLS_SKIP_VERIFY')):
    if key in request:
        env_vars[var] = '1' if request[key] else '0'
    else:
        env_vars[var] = env_vars.get(var, '0')
    request[key] = env_vars[var] == '1'
if env_vars['LIVEKIT_ENABLED'] == '0':
    env_vars['LIVEKIT_TURN_ENABLED'] = '0'
    request['livekit_turn_enabled'] = False
env_vars['LIVEKIT_PUBLIC_ADDRESS'] = request.get('livekit_public_address', env_vars.get('LIVEKIT_PUBLIC_ADDRESS', ''))
request['livekit_public_address'] = env_vars['LIVEKIT_PUBLIC_ADDRESS']

# Get allocated TCP ports from environment - NS8 allocates sequential ports
tcp_ports = os.environ.get('TCP_PORTS', '20001').split(',')

# Assign ports to services
env_vars['SYNAPSE_PORT'] = tcp_ports[0]
env_vars['ELEMENT_WEB_PORT'] = tcp_ports[1]
env_vars['CINNY_PORT'] = tcp_ports[2]
env_vars['M2A_PROXY_PORT'] = tcp_ports[4]

# Write updated configuration
agent.write_envfile("config.env", env_vars)

# An empty secret keeps the current one, so the UI never has to read it back.
# Clearing the URIs keeps the secret too: it is not used without URIs, and it is there if they come back.
if turn_shared_secret:
    fd = os.open('turn.env', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    # os.open applies the mode only to a new file, an existing one keeps its own
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, 'w') as tfp:
        tfp.write('TURN_SHARED_SECRET=' + turn_shared_secret + '\n')
elif turn_clear_secret and os.path.exists('turn.env'):
    os.remove('turn.env')

# For later use and backup. The TURN secret was popped from the request, turn.env is backed up instead
with open('config.json', 'w') as cfp:
    cfp.write(json.dumps(request))

# Configure Traefik routes for Synapse Matrix server
response = agent.tasks.run(
    agent_id=agent.resolve_agent_id('traefik@node'),
    action='set-route',
    data={
        'instance': os.environ['MODULE_ID'] + '-synapse',
        'url': 'http://127.0.0.1:' + env_vars['SYNAPSE_PORT'],
        'host': synapse_domain_name,
        'http2https': True,
        'lets_encrypt': lets_encrypt,
    },
)
agent.assert_exp(response['exit_code'] == 0)

# Configure Traefik routes for Element Web client
if element_domain_name:
    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id('traefik@node'),
        action='set-route',
        data={
            'instance': os.environ['MODULE_ID'] + '-element',
            'url': 'http://127.0.0.1:' + env_vars['ELEMENT_WEB_PORT'],
            'host': element_domain_name,
            'http2https': True,
            'lets_encrypt': lets_encrypt,
        },
    )
    agent.assert_exp(response['exit_code'] == 0)
else:
    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id('traefik@node'),
        action='delete-route',
        data={
            'instance': os.environ['MODULE_ID'] + '-element'
        },
    )

# Configure Traefik routes for Cinny client
if cinny_domain_name:
    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id('traefik@node'),
        action='set-route',
        data={
            'instance': os.environ['MODULE_ID'] + '-cinny',
            'url': 'http://127.0.0.1:' + env_vars['CINNY_PORT'],
            'host': cinny_domain_name,
            'http2https': True,
            'lets_encrypt': lets_encrypt,
        },
    )
    agent.assert_exp(response['exit_code'] == 0)
else:
    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id('traefik@node'),
        action='delete-route',
        data={
            'instance': os.environ['MODULE_ID'] + '-cinny'
        },
    )

# Bind the new domain, overriding previous values (unbind)
agent.bind_user_domains([ldap_domain])


# Enable or disable matrix2acrobits proxy routes depending on nethvoice_auth_url
m2a_port = env_vars.get('M2A_PROXY_PORT', '')
module_id = os.environ.get('MODULE_ID', 'matrix1')

if nethvoice_auth_url:
    proxy_url = 'http://127.0.0.1:' + (m2a_port if m2a_port else '8080')
    # create /m2a route
    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id('traefik@node'),
        action='set-route',
        data={
            'instance': module_id + '-m2a',
            'name': module_id + '-m2a',
            'host': synapse_domain_name,
            'path': '/m2a',
            'url': proxy_url,
            'lets_encrypt': lets_encrypt,
            'strip_prefix': True,
        },
    )
    agent.assert_exp(response['exit_code'] == 0)

    # create push notification route
    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id('traefik@node'),
        action='set-route',
        data={
            'instance': module_id + '-push',
            'name': module_id + '-push',
            'host': synapse_domain_name,
            'path': '/_matrix/push/v1/notify',
            'url': proxy_url,
            'lets_encrypt': lets_encrypt,
            'strip_prefix': False,
        },
    )
    agent.assert_exp(response['exit_code'] == 0)

    m2a = {
        'MATRIX_HOMESERVER_URL': 'https://' + synapse_domain_name,
        'PROXY_PORT': env_vars['M2A_PROXY_PORT'],
        'AS_USER_ID': '@_acrobits_proxy:' + synapse_domain_name,
        'EXT_AUTH_URL': nethvoice_auth_url,
        'LOGLEVEL': 'info',
    }
    agent.write_envfile("m2a.env", m2a)
else:
    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id('traefik@node'),
        action='delete-route',
        data={
            'instance': module_id + '-m2a'
        },
    )

    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id('traefik@node'),
        action='delete-route',
        data={
            'instance': module_id + '-push'
        },
    )
