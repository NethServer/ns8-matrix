import json
import sys
import os
import subprocess
import agent
from agent.ldapproxy import Ldapproxy

def split_list(value):
    return [item.strip() for item in value.split(',') if item.strip()]

# retrieve LDAP domains list
lp = Ldapproxy()
domains = []
for key in lp.get_domains_list():
    domains.append({
        "name": key,
        "label": key,
        "value": key,
    })

config = {}

if os.path.exists("config.env"):
    # Read current configuration from config file
    env_vars = agent.read_envfile("config.env")

    # Extract configuration values
    config['synapse_domain_name'] = env_vars.get('SYNAPSE_DOMAIN_NAME', '')
    config['element_domain_name'] = env_vars.get('ELEMENT_DOMAIN_NAME', '')
    config['cinny_domain_name'] = env_vars.get('CINNY_DOMAIN_NAME', '')
    config['ldap_domain'] = env_vars.get('LDAP_DOMAIN', '')
    config['mail_from'] = env_vars.get('MAIL_FROM', '')
    config['lets_encrypt'] = env_vars.get('LETS_ENCRYPT', '0') == '1'
    config['domains_list'] = domains
    config['nethvoice_auth_url'] = env_vars.get('NETHVOICE_AUTH_URL', '')
    config['federation'] = env_vars.get('FEDERATION', '0') == '1'
    config['federation_whitelist'] = split_list(env_vars.get('FEDERATION_WHITELIST', ''))
    config['turn_uris'] = split_list(env_vars.get('TURN_URIS', ''))
    config['max_upload_size_mb'] = int(env_vars.get('MAX_UPLOAD_SIZE_MB') or 50)
    config['local_media_lifetime_days'] = int(env_vars.get('LOCAL_MEDIA_LIFETIME_DAYS') or 0)
    config['remote_media_lifetime_days'] = int(env_vars.get('REMOTE_MEDIA_LIFETIME_DAYS') or 0)
    config['log_level'] = env_vars.get('LOG_LEVEL', 'INFO')
    config['search_all_users'] = env_vars.get('SEARCH_ALL_USERS', '0') == '1'
else:
    # No configuration file found, return empty configuration
    config['synapse_domain_name'] = ''
    config['element_domain_name'] = ''
    config['cinny_domain_name'] = ''
    config['ldap_domain'] = ''
    config['mail_from'] = ''
    config['lets_encrypt'] = False
    config['domains_list'] = domains
    config['nethvoice_auth_url'] = ''
    config['federation'] = False
    config['federation_whitelist'] = []
    config['turn_uris'] = []
    config['max_upload_size_mb'] = 50
    config['local_media_lifetime_days'] = 0
    config['remote_media_lifetime_days'] = 0
    config['search_all_users'] = True
    config['log_level'] = 'INFO'

config['turn_shared_secret_set'] = os.path.exists('turn.env')

env_vars = agent.read_envfile("config.env") if os.path.exists("config.env") else {}
config['livekit_enabled'] = env_vars.get('LIVEKIT_ENABLED', '0') == '1'
config['livekit_turn_enabled'] = env_vars.get('LIVEKIT_TURN_ENABLED', '0') == '1'
config['livekit_public_address'] = env_vars.get('LIVEKIT_PUBLIC_ADDRESS', '')
config['livekit_tls_skip_verify'] = env_vars.get('LIVEKIT_TLS_SKIP_VERIFY', '0') == '1'
config['encryption_enabled'] = env_vars.get('ENCRYPTION_ENABLED', '1') == '1'
config['livekit_detected_address'] = os.environ.get('DETECTED_PUBLIC_IP', '')
config['livekit_ports'] = ['7881/tcp', '7882/udp']
if config['livekit_turn_enabled']:
    config['livekit_ports'].append('3478/udp')


def in_use(*ports):
    return subprocess.run(['port-owner', *ports], stdout=subprocess.DEVNULL).returncode != 0


# Checked only while off: once on, the ports belong to this module and must stay switchable off
config['livekit_ports_in_use'] = not config['livekit_enabled'] and in_use('7881/tcp', '7882/udp')
config['livekit_turn_port_in_use'] = not config['livekit_turn_enabled'] and in_use('3478/udp')

# Older releases used the Matrix host as user domain
config['matrix_server_name'] = env_vars.get('MATRIX_SERVER_NAME') or env_vars.get('SYNAPSE_DOMAIN_NAME', '')
if env_vars:
    # Locked only when a user is found: configure-module still refuses a change while the database is down
    users = subprocess.run(['matrix-users-domain'], capture_output=True, text=True)
    config['matrix_server_name_locked'] = users.returncode == 0 and users.stdout.strip() != ''
else:
    config['matrix_server_name_locked'] = False

json.dump(config, fp=sys.stdout)
