{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/matrix/get-configuration-output.json",
    "description": "Get Matrix configuration",
    "examples": [
        {
            "synapse_domain_name": "matrix.example.com",
            "element_domain_name": "chat.example.com",
            "cinny_domain_name": "cinny.example.com",
            "lets_encrypt": true,
            "ldap_domain": "users.example.com",
            "mail_from": "noreply@example.com"
        }
    ],
    "type": "object",
    "properties": {
        "synapse_domain_name": {
            "type": "string",
            "description": "Fully qualified domain name for the Matrix homeserver"
        },
        "element_domain_name": {
            "type": "string",
            "description": "Fully qualified domain name for the Element web client"
        },
        "cinny_domain_name": {
            "type": "string",
            "description": "Fully qualified domain name for the Cinny client"
        },
        "lets_encrypt": {
            "type": "boolean",
            "description": "Enable Let's Encrypt certificate management"
        },
        "ldap_domain": {
            "type": "string",
            "description": "LDAP domain name",
            "format": "domain-name"
        },
        "mail_from": {
            "title": "Email from address",
            "type": "string",
            "oneOf": [
                {
                    "type": "string",
                    "format": "email"
                },
                {
                    "type": "string",
                    "maxLength": 0
                }
            ]
        },
        "nethvoice_auth_url": {
            "description": "NethVoice Authentication URL",
            "oneOf": [
                {
                    "type": "string",
                    "format": "uri"
                },
                {
                    "type": "string",
                    "maxLength": 0
                }
            ]
        },
        "federation": {
            "type": "boolean"
        },
        "federation_whitelist": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "turn_uris": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "turn_shared_secret_set": {
            "type": "boolean",
            "description": "True if a TURN secret is stored. The secret itself is never returned"
        },
        "max_upload_size_mb": {
            "type": "integer"
        },
        "local_media_lifetime_days": {
            "type": "integer"
        },
        "remote_media_lifetime_days": {
            "type": "integer"
        },
        "log_level": {
            "type": "string",
            "enum": [
                "INFO",
                "WARNING",
                "DEBUG"
            ]
        },
        "search_all_users": {
            "type": "boolean",
            "description": "Let users find every user who logged in at least once, not only people they share a room with"
        },
        "livekit_enabled": {
            "type": "boolean"
        },
        "livekit_turn_enabled": {
            "type": "boolean"
        },
        "livekit_public_address": {
            "type": "string"
        },
        "livekit_detected_address": {
            "type": "string",
            "description": "Public address found by the last detection, empty if none"
        },
        "livekit_ports": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Ports to open or forward to this node, like 7881/tcp"
        },
        "livekit_tls_skip_verify": {
            "type": "boolean"
        },
        "encryption_enabled": {
            "type": "boolean"
        },
        "livekit_ports_in_use": {
            "type": "boolean",
            "description": "True if another application holds 7881/tcp or 7882/udp. Only checked while LiveKit is off"
        },
        "livekit_turn_port_in_use": {
            "type": "boolean",
            "description": "True if another application holds 3478/udp. Only checked while the TURN relay is off"
        },
        "matrix_server_name": {
            "type": "string",
            "description": "User domain, the Synapse server_name"
        },
        "matrix_server_name_locked": {
            "type": "boolean",
            "description": "True once a user exists in the database"
        }
    }
}
