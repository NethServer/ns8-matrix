{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "packageRules": [
    {
      "description": "PostgreSQL major upgrades need a data migration in update-module.d",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/postgres",
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
